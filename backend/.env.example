# ── JWT ──────────────────────────────────────────────────────────────
SECRET_KEY=changez_cette_clé_en_production_minimum_32_caractères
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=1

# ── MinIO (Storage objet) ─────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_RAW=docs-raw
MINIO_BUCKET_PROCESSED=docs-processed
MINIO_BUCKET_IMAGES=docs-images

# ── Embedding (HuggingFace, téléchargé automatiquement) ──────────────
EMBED_MODEL_NAME=intfloat/multilingual-e5-base
EMBED_QUERY_PREFIX=query:
EMBED_PASSAGE_PREFIX=passage:

# ── ChromaDB (base vectorielle) ───────────────────────────────────────
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=documents
ANONYMIZED_TELEMETRY=False

# ── SQLite ────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ── OCR ───────────────────────────────────────────────────────────────
TESSERACT_CMD=/usr/bin/tesseract
PADDLE_USE_GPU=false

# ── LLM Provider : choisissez UNE option ──────────────────────────────

# --- Option 1 : Groq (recommandé — gratuit sur console.groq.com) ------
USE_GROQ=true
GROQ_API_KEY=votre_clé_groq_ici
GROQ_MODEL=llama-3.3-70b-versatile

# --- Option 2 : Anthropic (Claude) -----------------------------------
# USE_ANTHROPIC=true
# ANTHROPIC_API_KEY=votre_clé_anthropic_ici
# ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# --- Option 3 : Ollama (100% local, aucune clé requise) ---------------
# USE_GROQ=false
# USE_ANTHROPIC=false
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_LLM_MODEL=qwen2.5:3b
# OLLAMA_EMBED_MODEL=nomic-embed-text
